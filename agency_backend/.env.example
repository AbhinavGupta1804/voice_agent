# Retell AI (voice agent)
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_WEBHOOK_VERIFY=true
# direct = Retell dials via create-phone-call (import Twilio number into Retell first)
# sip    = register-phone-call + Twilio SIP bridge (keep Twilio voice webhook)
RETELL_INTEGRATION_MODE=direct

# Twilio (telephony + WhatsApp/SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Public URL (ngrok or production) — required for webhooks and SIP mode
NGROK_URL=

# PostgreSQL
DB_URL=postgresql://postgres:postgres@localhost:5432/voice_agent

# Booking email via WhatsApp
BOOKING_EMAIL_WHATSAPP=919752713547
BOOKING_EMAIL_SESSION_TTL_SECONDS=600

# OpenAI (post-call analysis)
OPENAI_API_KEY=

# Groq (WhatsApp/SMS chat)
GROQ_API_KEY=

# Cal.com (appointments)
CAL_API_KEY=
CAL_EVENT_TYPE_ID=4881369

# Cloudflare R2 (optional call recordings if not using Retell URLs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=call-recordings
R2_PUBLIC_BASE_URL=

# Legacy ElevenLabs (optional — only if old webhooks still active)
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_WEBHOOK_SECRET=
