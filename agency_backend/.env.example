# Phase-1: fixed WhatsApp number while testing on Retell website
BOOKING_EMAIL_WHATSAPP=919752713547
BOOKING_EMAIL_SESSION_TTL_SECONDS=600

# Option 2: collect_email_via_whatsapp waits on Redis (seconds)
BOOKING_EMAIL_WAIT_TIMEOUT_SECONDS=90
BOOKING_EMAIL_POLL_INTERVAL_SECONDS=2
