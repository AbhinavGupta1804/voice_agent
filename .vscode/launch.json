    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI Server",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--host", "127.0.0.1",
                "--port", "8000",
                "--reload"
            ],
            "cwd": "${workspaceFolder}/app",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/app"
            },
            "envFile": "${workspaceFolder}/.env",
            "jinja": true,
            "justMyCode": false
        },
        {
            "name": "FastAPI Server (No Reload)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--host", "127.0.0.1",
                "--port", "8001"
            ],
            "cwd": "${workspaceFolder}/app",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/app"
            },
            "envFile": "${workspaceFolder}/.env",
            "jinja": true,
            "justMyCode": false
        },
